# Generated by npm run build:redirects. Install in the Rusonyx document root.
# Apache 2.4 + mod_rewrite. GitHub Pages does NOT execute this file.
RewriteEngine On

# Old pages go directly to their corresponding final page, including on www/http.
RewriteRule ^index\.html$ https://meteorboxing.ru/ [R=301,L,NE,QSD]
RewriteRule ^o-nas(?:/index\.html|/)?$ https://meteorboxing.ru/about.html [R=301,L,NE,QSD]
RewriteRule ^o-nas/ceny(?:/index\.html|/)?$ https://meteorboxing.ru/#prices [R=301,L,NE,QSD]
RewriteRule ^o-nas/foto(?:/index\.html|/)?$ https://meteorboxing.ru/photos.html [R=301,L,NE,QSD]
RewriteRule ^o-nas/video(?:/index\.html|/)?$ https://meteorboxing.ru/photos.html [R=301,L,NE,QSD]
RewriteRule ^trenirovki(?:/index\.html|/)?$ https://meteorboxing.ru/training.html [R=301,L,NE,QSD]
RewriteRule ^trenirovki/gruppovye-trenirovki(?:/index\.html|/)?$ https://meteorboxing.ru/group-training.html [R=301,L,NE,QSD]
RewriteRule ^trenirovki/individualnye-trenirovki(?:/index\.html|/)?$ https://meteorboxing.ru/personal-training.html [R=301,L,NE,QSD]
RewriteRule ^sorevnovaniya(?:/index\.html|/)?$ https://meteorboxing.ru/competitions.html [R=301,L,NE,QSD]
RewriteRule ^uroki-nachinayushchim(?:/index\.html|/)?$ https://meteorboxing.ru/beginners.html [R=301,L,NE,QSD]
RewriteRule ^schedule(?:/index\.html|/)?$ https://meteorboxing.ru/schedule.html [R=301,L,NE,QSD]
RewriteRule ^otzyvy(?:/index\.html|/)?$ https://meteorboxing.ru/reviews.html [R=301,L,NE,QSD]
RewriteRule ^stati(?:/index\.html|/)?$ https://meteorboxing.ru/articles.html [R=301,L,NE,QSD]
RewriteRule ^contact-us(?:/index\.html|/)?$ https://meteorboxing.ru/contacts.html [R=301,L,NE,QSD]
RewriteRule ^prices\.html$ https://meteorboxing.ru/#prices [R=301,L,NE,QSD]
RewriteRule ^stati/kak-vybrat-luchshiy-klub-boksa-v-moskve-kak-vybrat-trenera-po-boksu(?:/index\.html|/)?$ https://meteorboxing.ru/article-kak-vybrat-luchshiy-klub-boksa-v-moskve-kak-vybrat-trenera-po-boksu.html [R=301,L,NE,QSD]
RewriteRule ^stati/plyusy-i-minusy-boksa(?:/index\.html|/)?$ https://meteorboxing.ru/article-plyusy-i-minusy-boksa.html [R=301,L,NE,QSD]
RewriteRule ^stati/pochemu-stoit-poyti-na-boks(?:/index\.html|/)?$ https://meteorboxing.ru/article-pochemu-stoit-poyti-na-boks.html [R=301,L,NE,QSD]
RewriteRule ^stati/boks-chto-eto-takoe(?:/index\.html|/)?$ https://meteorboxing.ru/article-boks-chto-eto-takoe.html [R=301,L,NE,QSD]

# An empty query string /? is a duplicate; keep real tracking query parameters.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*\?\s
RewriteRule ^(.*)$ https://meteorboxing.ru/$1 [R=301,L,NE,QSD]

RewriteCond %{HTTP_HOST} ^www\.meteorboxing\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://meteorboxing.ru/$1 [R=301,L,NE]

# Respect HTTPS terminated by the hosting provider's reverse proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^(.*)$ https://meteorboxing.ru/$1 [R=301,L,NE]
